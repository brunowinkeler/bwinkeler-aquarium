{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2015",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // The engine runs on webOS 4 (Chromium 53): ES2015 library APIs only.
    "lib": ["ES2015", "ES2016.Array.Include", "DOM"],
    "types": [],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
