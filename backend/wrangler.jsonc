{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bwinkeler-aquarium",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "aquarium.bwinkeler.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "minify": true,
  "upload_source_maps": true,
  // The PWA (and the TV browser build under /tv/); run `npm run build` before `wrangler dev`.
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/health/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "AQUARIUMS", "class_name": "AquariumDO" },
      { "name": "JOIN_CODES", "class_name": "JoinCodeDO" },
      { "name": "REGISTRY", "class_name": "RegistryDO" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AquariumDO", "JoinCodeDO", "RegistryDO"] }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "bwinkeler-aquarium-files" }],
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 3, "period": 60 } },
    { "name": "JOIN_LIMITER", "namespace_id": "4102", "simple": { "limit": 10, "period": 60 } },
  ],
  // Secret (wrangler secret put): IP_HASH_KEY, the HMAC key for per-IP creation quotas.
  "vars": {
    "PUBLIC_ORIGIN": "https://aquarium.bwinkeler.com",
    "RECONNECT_WINDOW_HOURS": "4",
    "MAX_LIVE_AQUARIUMS": "50",
    "CREATIONS_PER_IP_PER_DAY": "10",
    "MAX_PHONES": "10",
    "UPLOADS_PER_HOUR": "60",
  },
}
