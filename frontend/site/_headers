/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss://aquarium.bwinkeler.com; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  Permissions-Policy: accelerometer=(), camera=(self), display-capture=(), geolocation=(), gyroscope=(), microphone=(), midi=(), payment=(), usb=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/join/assets/*
  Cache-Control: public, max-age=31536000, immutable

/join/icons/*
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache

/join/sw.js
  Cache-Control: no-cache

/join/manifest.webmanifest
  Cache-Control: no-cache

/tv/*
  Cache-Control: no-cache
